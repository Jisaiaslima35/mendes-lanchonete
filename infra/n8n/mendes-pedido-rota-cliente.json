        -464,
        0
      ],
      "webhookId": "7020f446-35d3-40be-80ef-959cfa2b4b49"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Discrimina por modality: mesa/pickup/delivery têm mensagens diferentes.\nconst o = $input.item.json.body || $input.item.json;\nconst modality = o.modality || 'delivery';\nconst nome = o.customer_name || 'cliente';\nconst id = o.order_id || '#';\nconst addr = o.delivery_address || 'Endereço não informado';\n\nlet text;\nif (modality === 'mesa') {\n  const mesaLabel = o.mesa || addr.replace(/^Mesa\\s+/i, '');\n  text = `🍽 Olá, ${nome}! Seu pedido ${id} acabou de sair da cozinha e o garçom já está levando até a sua Mesa ${mesaLabel}. Bom apetite!`;\n} else if (modality === 'pickup') {\n  text = `🛍 Olá, ${nome}! Seu pedido ${id} já está pronto e embalado no balcão esperando por você. Pode vir retirar! Te aguardamos.`;\n} else {\n  // delivery (mantém texto padrão com entregador)\n  text = `🛵💨 Olá, ${nome}!\\n\\nSeu pedido ${id} acabou de sair para entrega e está a caminho do seu endereço:\\n📍 ${addr}\\n\\nLogo o entregador chega aí! Obrigado pela preferência. 🍔`;\n}\n\nreturn [{ json: { number: o.customer_phone, text, order_id: o.order_id } }];\n"
      },
      "id": "b09ff8ac-fcac-4032-a4ec-8938ae5fd500",
      "name": "Formatar Mensagem Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evo.automacaojs.us/message/sendText/automacaojs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "apikey",
              "value": "REDACTED_USE_N8N_CREDENTIALS"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": {{ JSON.stringify($json.number) }},\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"delay\": 1200\n}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
