# ====================================================================
#  Mendes Lanchonete — variáveis de ambiente
# ====================================================================
#  Copie este arquivo pra `.env.local` e preencha com seus valores.
#  NUNCA versione o `.env.local` (já está no .gitignore).
#
#  Em produção, as mesmas variáveis são injetadas via systemd
#  EnvironmentFile= / drop-in.
# ====================================================================


# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Banco Postgres direto (pra rodar migrations)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOUR_REF.supabase.co:5432/postgres


# ===== Next.js =====
NEXT_PUBLIC_TENANT_SLUG=mendes
NEXT_PUBLIC_SITE_URL=https://your-subdomain.example.com


# ===== Mercado Pago (Pix) =====
# Pegar em https://www.mercadopago.com.br/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Webhook público que o MP vai chamar quando o Pix for pago
MP_NOTIFICATION_URL=

# E-mail/CPF padrão caso o cliente não preencha
MP_DEFAULT_PAYER_EMAIL=
MP_DEFAULT_PAYER_CPF=


# ===== n8n (integração WhatsApp) =====
# Webhook do workflow "Mendes → WhatsApp dono" (novo pedido / Pix confirmado)
N8N_ORDER_WEBHOOK_URL=

# Webhook do workflow "Mendes - Pedido em Rota" (cliente notificado no saiu_entrega)
N8N_DISPATCH_WEBHOOK_URL=
